#!/bin/bash

# $1: remote name (e.g., origin)
# $2: remote url (e.g., git@github.com:ckeiituk/outclash.git)

# Only run the format check when pushing to origin (ckeiituk/outclash)
if [ "$1" = "origin" ] && echo "$2" | grep -Eq 'github\.com[:/]+ckeiituk/outclash(\.git)?$'; then
    echo "[pre-push] Detected push to origin (ckeiituk/outclash)"
    echo "[pre-push] Running pnpm format:check..."

    pnpm format:check
    if [ $? -ne 0 ]; then
        echo "❌ Code format check failed. Please fix formatting before pushing."
        exit 1
    fi
else
    echo "[pre-push] Not pushing to target repo. Skipping format check."
fi

exit 0
